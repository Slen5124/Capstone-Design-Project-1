        uuid report_file_id FK
        string comparison_rule_version
        string comparison_status
        string status
        boolean is_current
    }
    model_versions {
        uuid id PK
        uuid model_id FK
        string version
    }
    stored_files {
        uuid id PK
        uuid schedule_id FK
        string bucket
        string object_key
        string file_kind
        bigint size_bytes
        string sha256
        string upload_status

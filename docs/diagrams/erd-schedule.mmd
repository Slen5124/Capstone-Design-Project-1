%% 이전 설계 참고도. 현재 구현 SQL과의 차이는 README.md 참고.
erDiagram
    sites ||..o{ schedules : "공정표 1:N"
    schedules o|..o{ stored_files : "원본 PDF"
    schedules ||..o{ schedule_items : "작업 목록 · schedule_id"
    schedule_items o|..|o schedule_items : "선행·후행 각각 0..1"
    schedule_items ||..o{ schedule_item_locations : "장소 연결"
    locations ||..o{ schedule_item_locations : "장소별 관련 작업"
    sites {
        uuid id PK
        string code UK
        string name
    }
    schedules {
        uuid id PK
        uuid site_id FK
        string version
    }
    stored_files {
        uuid id PK
        uuid schedule_id FK
        string bucket
        string object_key
        string file_kind
        bigint size_bytes
        string sha256
        string upload_status
    }
    schedule_items {
        uuid id PK
        uuid schedule_id FK
        int source_task_id
        int display_order
        int week
        string task_name
        date start
        date finish
        uuid predecessor_id FK
        uuid successor_id FK
    }
    schedule_item_locations {
        uuid id PK
        uuid schedule_item_id FK
        uuid location_id FK
    }
    locations {
        uuid id PK
        uuid site_id FK
        string code
        string name
        text description
    }
